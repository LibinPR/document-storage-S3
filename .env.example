# Set these in your shell or deployment environment. Never put real credentials here.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=replace-with-your-private-bucket
DOCUMENT_PRESIGNED_URL_TTL_SECONDS=300
DOCUMENT_DEFAULT_PAGE_SIZE=20
DOCUMENT_MAX_PAGE_SIZE=100
# Generate a random secret of at least 32 bytes for signed continuation cursors.
DOCUMENT_CURSOR_SIGNING_SECRET=replace-with-a-random-32-byte-minimum-secret
